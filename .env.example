# Copy this file to .env and change the values. .env is ignored by git; never commit it.
# The server checks every setting when it starts and stops with a list of what is wrong.

# --- Required -------------------------------------------------------------------------------
# PostgreSQL connection string (K14 starts a matching database with Docker).
DATABASE_URL=postgresql://campushop:campushop@localhost:5433/campushop
# Signs the login cookie. At least 32 characters. Make your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This sample value is public, so the server refuses it in production.
JWT_SECRET=dev-only-secret-change-me-before-you-deploy-0123456789

# --- Server ---------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Web app ----------------------------------------------------------------------------------
# The origin the web app is served from (CORS allows only this one). `npm run dev` serves the app on 5173.
CLIENT_ORIGIN=http://localhost:5173
# Folder of the built web app. When set, this server serves it too (one origin: the simplest way to host the demo).
CLIENT_DIST=

# --- Login cookie ---------------------------------------------------------------------------
# Must be true in production (https). Leave false for http://localhost.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# --- Email (the defaults match the Mailpit container from K14) --------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Campus Hop <no-reply@campushop.local>

# --- Maps (optional: empty means the built-in fake is used) ---------------------------------
GOOGLE_MAPS_API_KEY=

# --- Campus rules. Some are still open questions in the SRS (Appendix C), so they are settings, not code.
# Path to the boundary polygon file (read by task B4; SRS Q12 is open).
CAMPUS_BOUNDARY=
# Metres of margin before a journey that left campus is cancelled (SRS Q12).
GEOFENCE_GRACE_M=200
# Minutes a LIVE journey waits for a booking before it expires (SRS Q7).
LIVE_WINDOW_MIN=15
# Seconds location sharing continues after a trip completes (NFR-5.4).
SHARING_STOP_SECONDS=30
# Metres that count as "near the pickup point".
PROXIMITY_M=300
