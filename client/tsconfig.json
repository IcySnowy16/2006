{
  "//": "Typecheck only (Vite builds). The shared contract is read from source through the alias, like Vite and the tests do.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": { "@campus-hop/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
