+ * When the driver reaches a pickup point: the journey's departure plus the share of the drive before that point (C-014).
+ * A journey that is still LIVE or OPEN has not started, so a departure time already passed means the driver leaves now, not then:
+ * the drive is counted from `now`. A pickup time is therefore never earlier than now.
+ */
+export function estimatePickupTime(departureTime: Date, now: Date, progress: number, durationSec: number): Date {
+  const leaves = Math.max(departureTime.getTime(), now.getTime());
