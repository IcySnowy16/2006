+/** A driver, a journey leaving now with `riders` confirmed bookings each holding `fare` from a $10 wallet, and a pending request. */
+async function heldTrip(riders = 1, fare = 300) {
+  const t = makeTestApp();
+  const cat = await makeCatalog();
+  const driver = await makeDriver();
+  const journey = await makeJourney(driver.id, { status: 'OPEN', seatsAvailable: 3 - riders, departureTime: t.clock.now() });
+  const passengers = [];
+  const bookings = [];
+  for (let i = 0; i < riders; i++) {
+    const p = await makePassenger({ balanceCents: 1000, heldCents: fare });
+    passengers.push(p);
+    bookings.push(
+      await makeBooking(journey.id, p.id, cat.pickup.hallABus.id, cat.pickup.gateBus.id, {
+        status: 'CONFIRMED',
+        currentFareCents: fare,
+        heldCents: fare,
+        paymentStatus: 'HELD',
+      }),
+    );
+  }
+  const waiting = await makePassenger({ balanceCents: 500 });
+  const pending = await makeBooking(journey.id, waiting.id, cat.pickup.hallABus.id, cat.pickup.gateBus.id);
+  const wallet = (id: string) => prisma().wallet.findUniqueOrThrow({ where: { userId: id } });
+  const inbox = async (id: string) => (await prisma().notification.findMany({ where: { userId: id } })).map((n) => n.message);
+  return { t, cat, driver, journey, passengers, bookings, waiting, pending, wallet, inbox, jobs: new Sweeps(t.ctx) };
