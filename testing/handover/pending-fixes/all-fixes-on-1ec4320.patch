+++ b/server/src/security/security.test.ts
@@ -0,0 +1,56 @@
+/**
+ * NFR-2.1 and B-NA-006: the auth rate limits count failed attempts per e-mail address, with a looser ceiling per network address.
+ * A tiny app stands in for the auth routes: password "right" signs in (200), anything else is INVALID_CREDENTIALS (401).
+ */
+import express from 'express';
+import request from 'supertest';
+import { describe, expect, it } from 'vitest';
+import { AppError } from '../errors/AppError';
+import { createErrorHandler } from '../middleware/errorHandler';
+import { createRateLimiters, DEFAULT_LIMITS, type RateLimits } from './index';
+
+function makeApp(limits: RateLimits) {
+  const app = express();
+  app.use(express.json());
+  const limiters = createRateLimiters(limits);
+  app.post('/login', ...limiters.login, (req, res, next) => {
+    if ((req.body as { password?: string }).password === 'right') res.status(200).json({ ok: true });
+    else next(new AppError('INVALID_CREDENTIALS'));
+  });
+  app.post('/resend', ...limiters.resend, (_req, res) => void res.status(204).end());
+  app.use(createErrorHandler({ logger: { warn: () => undefined, error: () => undefined } }));
+  return app;
+}
+
+const login = (app: express.Express, ntuEmail: string, password: string) => request(app).post('/login').send({ ntuEmail, password });
+
+describe('B-NA-006: auth rate limits', () => {
+  it('the defaults: 10 failed tries per e-mail, 5 resends per e-mail, 100 per network address', () => {
+    expect(DEFAULT_LIMITS).toEqual({ login: 10, register: 10, verify: 10, resend: 5, perAddress: 100 });
+  });
+
+  it('failed tries for one e-mail stop only that e-mail; another person on the same address signs in', async () => {
+    const app = makeApp({ ...DEFAULT_LIMITS, login: 3 });
+    for (let i = 0; i < 3; i++) expect((await login(app, 'a@e.ntu.edu.sg', 'wrong')).status).toBe(401);
+    expect((await login(app, 'a@e.ntu.edu.sg', 'wrong')).body.code).toBe('TOO_MANY_REQUESTS');
+    expect((await login(app, 'b@e.ntu.edu.sg', 'right')).status).toBe(200);
+  });
+
+  it('successful sign-ins are not counted at all', async () => {
+    const app = makeApp({ ...DEFAULT_LIMITS, login: 3, perAddress: 5 });
+    for (let i = 0; i < 12; i++) expect((await login(app, `u${i % 2}@e.ntu.edu.sg`, 'right')).status).toBe(200);
+  });
+
+  it('the network address has its own, looser ceiling of failed tries across all e-mails', async () => {
+    const app = makeApp({ ...DEFAULT_LIMITS, login: 3, perAddress: 5 });
+    for (let i = 0; i < 5; i++) expect((await login(app, `x${i}@e.ntu.edu.sg`, 'wrong')).status).toBe(401);
+    expect((await login(app, 'y@e.ntu.edu.sg', 'wrong')).body.code).toBe('TOO_MANY_REQUESTS');
+  });
+
+  it('resend counts every request, per e-mail', async () => {
+    const app = makeApp({ ...DEFAULT_LIMITS, resend: 2 });
+    for (let i = 0; i < 2; i++) expect((await request(app).post('/resend').send({ ntuEmail: 'a@e.ntu.edu.sg' })).status).toBe(204);
+    expect((await request(app).post('/resend').send({ ntuEmail: 'a@e.ntu.edu.sg' })).status).toBe(429);
+    expect((await request(app).post('/resend').send({ ntuEmail: 'b@e.ntu.edu.sg' })).status).toBe(204);
+  });
+});
