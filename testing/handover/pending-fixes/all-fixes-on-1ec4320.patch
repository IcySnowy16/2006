 /** Task K9: TanStack Query wrappers over `call`, keyed by endpoint name + input so a mutation can refresh exactly what it changed. */
+import { useRef } from 'react';
 import { useMutation, useQuery, useQueryClient, type UseMutationOptions, type UseQueryOptions } from '@tanstack/react-query';
 import type { EndpointName } from '@campus-hop/shared';
 import { call, type CallInput, type Out } from './client';
@@ -16,3 +17,18 @@ export function useRefresh() {
   const qc = useQueryClient();
   return (...names: EndpointName[]) => Promise.all(names.map((n) => qc.invalidateQueries({ queryKey: [n] })));
 }
+
+/**
+ * One request at a time from a button. A second tap can arrive before React has drawn the button busy, so `isPending` alone
+ * lets it through (and the server answers it 409 after the first one worked): this guard flips at once and is released when
+ * the request settles, after the mutation's own `onSettled` (such as a refresh) has run.
+ * `const once = useOneAtATime(); once(accept.mutate, { params: { id } })`; buttons that must not overlap share one guard.
+ */
+export function useOneAtATime() {
+  const busy = useRef(false);
+  return <I>(mutate: (input: I, options: { onSettled: () => void }) => void, input: I) => {
+    if (busy.current) return;
+    busy.current = true;
+    mutate(input, { onSettled: () => void (busy.current = false) });
+  };
+}
