+    expect(await active(w.driver.id)).toBe(0); // the driver may go live again
+    // A late position from the old trip is dropped quietly.
+    expect((await new LocationService(w.t.ctx).handleUpdate(w.driver.id, w.journey.id, fixAt(w.t.clock.now()))).accepted).toBe(false);
+  });
