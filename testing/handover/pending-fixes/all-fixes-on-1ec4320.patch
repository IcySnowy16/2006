+/**
+ * Task A6: which role a user's current trip is in, if any (UC-2.EX.2).
+ *
+ * A trip as a DRIVER is a journey of theirs that is LIVE, OPEN, FULL or IN_PROGRESS. A trip as a PASSENGER is a PENDING or
+ * CONFIRMED booking of theirs on such a journey (PENDING counts: the driver may still accept it). Used by RoleService (switching
+ * away from a trip is refused, choosing the trip's role is always allowed) and by AuthService.login (sign-in acts in that role).
+ */
+import type { ActiveRole } from '@campus-hop/shared';
+import type { PrismaClient } from '@prisma/client';
+
+const TRIP_JOURNEY_STATUSES = ['LIVE', 'OPEN', 'FULL', 'IN_PROGRESS'] as const;
+
+/** The roles the user is on a trip in right now: [] when none (the other services keep it to one role at a time). */
+export async function tripRoles(db: PrismaClient, userId: string): Promise<ActiveRole[]> {
+  const asDriver = await db.journey.count({ where: { driverId: userId, status: { in: [...TRIP_JOURNEY_STATUSES] } } });
+  const asPassenger = await db.booking.count({
+    where: { passengerId: userId, status: { in: ['PENDING', 'CONFIRMED'] }, journey: { status: { in: [...TRIP_JOURNEY_STATUSES] } } },
+  });
+  return [...(asDriver > 0 ? (['DRIVER'] as const) : []), ...(asPassenger > 0 ? (['PASSENGER'] as const) : [])];
+}
