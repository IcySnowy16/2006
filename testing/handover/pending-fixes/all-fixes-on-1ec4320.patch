+   * in the meantime, so running it twice is harmless.
+   */
+  async abandon(journeyId: string, cutoff: Date): Promise<boolean> {
+    const queue = new EventQueue();
+    const done = await withTransaction(async (tx) => {
+      await lockJourney(tx, journeyId);
+      const jrow = await tx.journey.findUnique({ where: { id: journeyId } });
+      if (!jrow || jrow.status !== 'IN_PROGRESS' || !jrow.startedAt || jrow.startedAt > cutoff) return false;
+      if ((await tx.locationUpdate.count({ where: { journeyId, receivedAt: { gt: cutoff } } })) > 0) return false;
+
+      const journey = Journey.fromRecord(jrow as unknown as JourneyRecord);
+      journey.abandon();
+      const confirmed = await tx.booking.findMany({ where: { journeyId, status: 'CONFIRMED' }, orderBy: { passengerId: 'asc' } });
+      for (const b of confirmed) {
+        await this.wallets.release(tx, b.id); // what is still held goes back; a no-show's hold was released already
+        // Straight to CANCELLED: Booking.cancel() refuses a rider who was picked up, but this trip will never be completed.
+        await tx.booking.update({ where: { id: b.id }, data: { status: 'CANCELLED', heldCents: 0 } });
+      }
+      await tx.journey.update({ where: { id: journeyId }, data: { status: journey.status, cancelReason: 'ABANDONED' } });
+      queue.push('JourneyCancelled', { journeyId, driverId: jrow.driverId, reason: 'ABANDONED', passengerIds: confirmed.map((b) => b.passengerId) });
+      return true;
+    });
+    if (done) await this.ctx.bus.publish(queue);
+    return done;
+  }
