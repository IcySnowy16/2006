+/**
+ * What a person typed as dollars, in whole cents: only a plain amount with at most two decimals ("5", "5.5", "5.50"), the same
+ * rule as the server's Money.fromDollars. Anything else ("0x2", "1e2", "Infinity", "-1", "") is null. Panel N-f1-04: Number()
+ * read "0x2" as $2.00.
+ */
+export function centsFromDollars(text: string): number | null {
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(text.trim());
+  if (!m) return null;
+  const cents = Number(m[1]) * 100 + Number((m[2] ?? '').padEnd(2, '0'));
+  return Number.isSafeInteger(cents) ? cents : null;
+}
+
